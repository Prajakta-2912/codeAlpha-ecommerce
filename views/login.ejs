<!DOCTYPE html>
<html>

<head>

<title>Login</title>

<link rel="stylesheet" href="/css/style.css">

</head>

<body>

<div class="login-container">

<div class="login-box">

<h1>Welcome Back 👋</h1>

<p class="login-subtitle">
Login to your ecommerce dashboard
</p>

<form action="/login" method="POST">

<input 
type="email"
name="email"
placeholder="Enter Email"
required
>

<input 
type="password"
name="password"
placeholder="Enter Password"
required
>

<button type="submit">
Login
</button>

</form>

<p class="login-extra">
Demo:
admin@gmail.com / 1234
</p>

</div>

</div>

</body>

</html>
